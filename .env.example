# Copy to .env and fill in. .env is gitignored.

# --- Voice ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=          # E.164, e.g. +14155551234
DEEPGRAM_API_KEY=
NGROK_AUTHTOKEN=
PUBLIC_BASE_URL=              # ngrok https URL, no trailing slash. Changes on restart.

# --- Messaging (AgentPhone: SMS/iMessage, not voice) ---
# Outbound is blocked pending A2P 10DLC registration -- inbound works today.
# See services/agentphone_router.py. Outbound comms go through email (below)
# until that clears.
AGENTPHONE_API_KEY=
AGENTPHONE_WEBHOOK_SECRET=    # signs X-Webhook-Signature on inbound. Set before demo.
AGENTPHONE_FROM_NUMBER=       # E.164. Optional if the account only has one number.

# --- Email (waitlist offers, cancellation exit survey) ---
# Generic SMTP -- Gmail App Password, SendGrid relay, Mailgun relay, all work
# by changing host/port only. See services/email.py.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_APP_PASSWORD=
SMTP_FROM_NAME=Relay

# --- Reasoning ---
ANTHROPIC_API_KEY=

# --- Data ---
MEDPLUM_BASE_URL=https://api.medplum.com
MEDPLUM_CLIENT_ID=
MEDPLUM_CLIENT_SECRET=

STEDI_API_KEY=
STEDI_TEST_PAYER_ID=          # sandbox magic value
STEDI_TEST_MEMBER_ID=

MOSS_API_KEY=

# --- Demo safety ---
# Flip to true at 16:00 when every team is hammering the same sandboxes.
# Replays saved fixtures/ instead of calling out. Demo is unaffected.
USE_FIXTURES=false
